{
  "expo": {
    "name": "Mello",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.communityspeak.z97eev",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Share photos from your gallery in chat",
        "NSMicrophoneUsageDescription": "Record voice messages and join voice rooms",
        "NSCameraUsageDescription": "Make video calls with language partners",
        "NSBluetoothAlwaysUsageDescription": "Use Bluetooth headsets for calls",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "icon": "./assets/images/android-icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.communityspeak.z97eev",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E9AE0",
          "defaultChannel": "default"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Make video calls with language partners",
          "microphonePermission": "Talk in audio calls and voice rooms"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "useLegacyPackaging": true,
            "enableProguardInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}